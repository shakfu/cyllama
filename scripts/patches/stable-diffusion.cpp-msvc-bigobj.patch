Add /bigobj to the MSVC compile options.

src/stable-diffusion.cpp has grown past the 65,279-section limit of the COFF
object format, so MSVC fails it with "error C1128: number of sections exceeded
object file format limit: compile with /bigobj". llama.cpp already carries the
equivalent lines in its own top-level CMakeLists.txt; this mirrors them,
including the COMPILE_LANGUAGE generator expressions so the flag is scoped the
same way as the neighbouring /utf-8.

--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -14,8 +14,10 @@
     # /MP is MSVC-only: icx rejects it outright once offloading is enabled.
     add_compile_options(
         $<$<AND:$<COMPILE_LANGUAGE:C>,$<C_COMPILER_ID:MSVC>>:/MP>
+        $<$<COMPILE_LANGUAGE:C>:/bigobj>
         $<$<COMPILE_LANGUAGE:C>:/utf-8>
         $<$<AND:$<COMPILE_LANGUAGE:CXX>,$<CXX_COMPILER_ID:MSVC>>:/MP>
+        $<$<COMPILE_LANGUAGE:CXX>:/bigobj>
         $<$<COMPILE_LANGUAGE:CXX>:/utf-8>
     )
 endif()
