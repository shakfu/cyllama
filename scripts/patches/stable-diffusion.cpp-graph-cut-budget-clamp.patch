diff --git a/src/core/ggml_extend.hpp b/src/core/ggml_extend.hpp
index d14d287..ee49bda 100644
--- a/src/core/ggml_extend.hpp
+++ b/src/core/ggml_extend.hpp
@@ -2407,8 +2413,19 @@ protected:
         GGML_ASSERT(plan_out != nullptr);
         GGML_ASSERT(gf != nullptr);
 
+        // The budget is a cap on what this graph may put in VRAM, so it has to
+        // be measured against the VRAM that is actually free right now -- not
+        // against the free VRAM observed when the context was created. Modules
+        // are budgeted once at init (max_graph_vram_bytes_for_module()) and a
+        // params storage block is only released when its tensors are disk
+        // backed, so by the time the diffusion model plans its graph the text
+        // encoder's weights are still resident and several GiB of the init-time
+        // budget no longer exist. Without this clamp an auto budget ("-1") on a
+        // single-GPU box hands every module the whole card, the planner merges
+        // the diffusion segments back into one blob that fitted at init, and the
+        // allocation fails outright.
         size_t effective_budget = max_graph_vram_bytes;
-        if (stream_layers_enabled && max_graph_vram_bytes > 0 && runtime_backend != nullptr) {
+        if (max_graph_vram_bytes > 0 && runtime_backend != nullptr) {
             ggml_backend_dev_t dev = ggml_backend_get_device(runtime_backend);
             if (dev != nullptr && ggml_backend_dev_type(dev) != GGML_BACKEND_DEVICE_TYPE_CPU) {
                 size_t free_vram = 0, total_vram = 0;
@@ -2416,7 +2433,7 @@ protected:
                 constexpr size_t safety_margin = 512ull * 1024 * 1024;
                 size_t free_clamp              = (free_vram > safety_margin) ? (free_vram - safety_margin) : 0;
                 if (free_clamp < effective_budget) {
-                    LOG_DEBUG("%s clamping streaming budget: actual free VRAM %.2f MB < user cap %.2f MB",
+                    LOG_DEBUG("%s clamping graph cut budget: actual free VRAM %.2f MB < budget %.2f MB",
                               get_desc().c_str(),
                               free_clamp / (1024.0 * 1024.0),
                               effective_budget / (1024.0 * 1024.0));
