diff --git a/src/core/ggml_extend.hpp b/src/core/ggml_extend.hpp
index d14d287..ee49bda 100644
--- a/src/core/ggml_extend.hpp
+++ b/src/core/ggml_extend.hpp
@@ -1789,6 +1789,12 @@ protected:
     template <typename T>
     static sd::Tensor<T> take_or_empty(std::optional<sd::Tensor<T>> tensor) {
         if (!tensor.has_value()) {
+            // compute() reports a failure as an empty optional, every caller
+            // here flattens that to an empty tensor, and their callers assert
+            // on empty. Some of compute()'s failure paths log nothing, so
+            // without this line a failed graph reaches the user as a bare
+            // GGML_ASSERT with no indication of what went wrong.
+            LOG_ERROR("runner compute failed; returning an empty tensor");
             return {};
         }
         return std::move(*tensor);
